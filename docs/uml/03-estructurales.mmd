classDiagram
  direction TB
  class ComponenteReporte {
    <<abstract · Composite>>
    +id string
    +aNodo(nivel)* NodoReporte
    +clonar()* ComponenteReporte
    +reemplazarMarcadores(valores)*
    +contarElementos() number
  }
  class Seccion {
    <<Compuesto>>
    -hijos ComponenteReporte[]
    +agregar(componentes) this
    +quitar(id) boolean
    +profundidad() number
    +buscarSeccion(clave) Seccion
  }
  class Parrafo
  class Tabla
  class Grafico
  class Indicador
  ComponenteReporte <|-- Seccion
