  class IReporte {
    <<interface · Decorator>>
    +obtenerDocumento() DocumentoReporte
  }
  class Reporte {
    -cuerpo Seccion
    +obtenerDocumento() DocumentoReporte
  }
  class DecoradorReporte {
    <<abstract>>
    #envuelto IReporte
    +obtenerDocumento() DocumentoReporte
    #decorar(doc)* DocumentoReporte
  }
